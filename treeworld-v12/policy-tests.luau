local R=require('./movement-rules')
local F=require('./fruit-rules')
local count=0
local function check(value,message)assert(value,message);count+=1 end
local function evaluate(overrides)
 local sample={allowedSpeed=16,ping=.05,windowTime=4,planarDistance=64,jumpDistance=6,airTime=0,floatingTime=0,groundDistance=3}
 for k,v in pairs(overrides)do sample[k]=v end;return R.evaluate(sample)
end
check(evaluate({})==nil,'Walking must remain allowed')
check(evaluate({planarDistance=96})==nil,'Normal sprint must remain allowed')
check(evaluate({airTime=1,floatingTime=1,groundDistance=17})==nil,'Normal jump')
check(evaluate({airTime=12,floatingTime=0,groundDistance=80})==nil,'Long fall')
check(evaluate({jumpDistance=800,badNetwork=true})==nil,'Lag correction')
check(evaluate({jumpDistance=800,grace=true})==nil,'Authorized teleport and spawn')
check(evaluate({jumpDistance=800,serverStall=true})==nil,'Server stall')
check(evaluate({planarDistance=800,seated=true})==nil,'Seat movement')
check(evaluate({jumpDistance=600})=='teleport','Abnormal teleport is a warning')
check(evaluate({planarDistance=240})=='speed','Sustained impossible speed')
check(evaluate({airTime=8,floatingTime=5,groundDistance=30})=='flight','Sustained unsupported flight')
check(R.network(.05,.01)=='green','Stable ping')
check(R.network(.2,.01)=='yellow','Elevated ping')
check(R.network(.4,.01)=='red','High latency')
check(R.network(.05,.15)=='red','High jitter')
check(not R.shouldKick({{kind='teleport',time=25}},30,0,30),'Single teleport never kicks')
local events={{kind='speed',time=0},{kind='flight',time=5},{kind='speed',time=10},{kind='flight',time=15},{kind='speed',time=20}}
check(not R.shouldKick(events,17,0,30),'Warning period required')
check(not R.shouldKick(events,24,0,4),'Network recovery grace required')
check(R.shouldKick(events,24,0,24),'Repeated corroborated movement after warnings')
check(not R.shouldKick(events,80,0,80),'Old violations expire')
check(not F.expired(0,419.9)and F.expired(0,420),'Fruit expires at exactly seven minutes')
check(F.pickup({born=0,claimed=false},20,8),'Nearby fruit can be collected')
check(not F.pickup({born=0,claimed=true},20,8),'Double pickup rejected')
check(not F.pickup({born=0,claimed=false},20,11),'Remote pickup rejected')
check(not F.pickup({born=0,claimed=false},420,8),'Expired fruit rejected')
check(F.increment(1)==2 and F.increment(2)==3,'Stacks increment')
check(F.increment(9999)==9999,'Bounded stack')
print('PASS '..count..' movement fairness and inventory assertions')
