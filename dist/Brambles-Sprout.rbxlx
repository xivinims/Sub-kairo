  <Item class="ServerScriptService" referent="11">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="12">
      <Properties>
        <string name="Name">BrambleServer</string>
      </Properties>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">AssetModels</string>
          <string name="Source"><![CDATA[local RS=game:GetService("ReplicatedStorage")
local Config=require(RS.Shared.Config)
local AssetModels={}
function AssetModels.load()
 local folder=RS:FindFirstChild("BrambleAssets")
 if folder and folder:GetAttribute("Ready") then return folder end
 if not folder then folder=Instance.new("Folder");folder.Name="BrambleAssets";folder.Parent=RS end
 local remaining=0
 for name,id in pairs(Config.Models or {}) do
  if id>0 and not folder:FindFirstChild(name) then
   remaining+=1
   task.spawn(function()
    local ok,container=pcall(function() return game:GetService("InsertService"):LoadAsset(id) end)
    if ok then
     -- Nothing from a catalog model is parented to the DataModel until all executable code is removed.
     for _,item in ipairs(container:GetDescendants()) do if item:IsA("LuaSourceContainer") then item:Destroy() end end
     local model=Instance.new("Model");model.Name=name
     for _,child in ipairs(container:GetChildren()) do if not child:IsA("PackageLink") then child.Parent=model end end
     container:Destroy()
     local part=model:FindFirstChildWhichIsA("BasePart",true)
     if part then
      for _,p in ipairs(model:GetDescendants()) do
       if p:IsA("BasePart") then
        p.Anchored=true;p.CanCollide=false;p.CanTouch=false
        if name=="BlueHand" or name=="RedHand" then
         p.Color=Color3.new(1,1,1)
         local texture=Config.Assets[name.."Texture"]
         if p:IsA("MeshPart") and texture and texture>0 then
          for _,a in ipairs(p:GetChildren()) do if a:IsA("SurfaceAppearance") then a:Destroy() end end
          p.TextureID="rbxassetid://"..texture
         end
        end
       end
      end
      model.WorldPivot=model:GetBoundingBox();model.Parent=folder
     else model:Destroy();warn("Empty imported model: "..name) end
    else warn("Import unavailable: "..name.." / "..tostring(container)) end
    remaining-=1
   end)
  end
 end
 local deadline=os.clock()+28
 while remaining>0 and os.clock()<deadline do task.wait(.1) end
 folder:SetAttribute("Ready",true)
 return folder
end
function AssetModels.place(template,parent,cf,height,name)
 local m=template:Clone();m.Name=name or template.Name
 local size=m:GetExtentsSize()
 m:ScaleTo(m:GetScale()*height/math.max(size.Y,.01));m.WorldPivot=m:GetBoundingBox();m:PivotTo(cf);m.Parent=parent
 return m
end
function AssetModels.decorate(world)
 local templates=RS:FindFirstChild("BrambleAssets");if not templates then return end
 local built=workspace:FindFirstChild("BrambleWorld")
 if built then
  for _,part in ipairs(built:GetDescendants()) do
   if part:IsA("BasePart") and (part.Name=="Wall" or part.Name=="EndWall" or part.Name=="EntryWall" or part.Name=="Partition" or part.Name=="BackWall") then part.Material=Enum.Material.Concrete;part.MaterialVariant="KitConcrete";part.Color=Color3.fromRGB(190,196,186)
   elseif part:IsA("BasePart") and (part.Name=="Floor" or part.Name=="Stage") then part.Material=Enum.Material.Concrete;part.MaterialVariant="KitFactoryTiles";part.Color=Color3.fromRGB(225,225,220) end
  end
 end
 for _,target in pairs(world.Targets) do
  local id=target:GetAttribute("Action")
  local name=if string.match(id,"^fuse") or string.match(id,"^cell") then "Battery" else if string.match(id,"^socket") then "Scanner" else if id=="exit" then "Doors" else if id=="power" or id=="master" or id=="start" then "BatteryHolder" else nil
  local template=name and templates:FindFirstChild(name)
  if template and not target:FindFirstChild("ImportedVisual") then
   local m=AssetModels.place(template,target,target.CFrame*CFrame.new(0,0,.7),if name=="Battery" then 1.5 else if name=="Doors" then 9 else 2.5,"ImportedVisual")
   target.Transparency=1
   local indicator=target:FindFirstChild("Indicator");if indicator then indicator.Transparency=1 end
   for _,p in ipairs(m:GetDescendants()) do if p:IsA("BasePart") then p:SetAttribute("TargetId",target:GetAttribute("TargetId"));p:SetAttribute("Sector",target:GetAttribute("Sector")) end end
  end
  local prompt=target:FindFirstChildOfClass("ProximityPrompt");if prompt then prompt.Enabled=false end
 end
 local root=workspace:FindFirstChild("BrambleWorld");if not root or root:FindFirstChild("ImportedKitScenery") then return end
 local scenery=Instance.new("Folder");scenery.Name="ImportedKitScenery";scenery.Parent=root
 for sector=1,7 do
  local origin=world.Origins[sector]
  for _,spec in ipairs({{"Panels",Vector3.new(-40,3,-120),6},{"Storage",Vector3.new(45,4,-155),9},{"Pipes",Vector3.new(-55,10,-80),8},{"BrickWalls",Vector3.new(40,3,-60),7}}) do
   local template=templates:FindFirstChild(spec[1]);if template then AssetModels.place(template,scenery,CFrame.new(origin+spec[2]),spec[3]) end
  end
 end
 local bramble=templates:FindFirstChild("BrambleTemplate")
 if bramble then local menu=root:FindFirstChild("MenuSet");local old=menu and menu:FindFirstChild("Bramble_Placeholder");if old then old:Destroy();world.createEnemy(menu,Vector3.new(6,6,67)) end end
 local battery=templates:FindFirstChild("Battery")
 if battery then
  for sector=1,7 do
   local prop=AssetModels.place(battery,scenery,CFrame.new(world.Origins[sector]+Vector3.new(12,3,-24)),1.5,"LoosePowerCube")
   local rootPart=prop:FindFirstChildWhichIsA("BasePart",true)
   for _,part in ipairs(prop:GetDescendants()) do if part:IsA("BasePart") then part.Anchored=false;part.CanCollide=true;part.CanQuery=true;part:SetAttribute("GrabMovable",true);if part~=rootPart then local weld=Instance.new("WeldConstraint");weld.Part0=rootPart;weld.Part1=part;weld.Parent=rootPart end end end
  end
 end
 local pack=templates:FindFirstChild("GrabPack")
 if pack then AssetModels.place(pack,scenery,CFrame.new(world.Origins[1]+Vector3.new(-20,4,-12)),3,"GrabPack_Equipment") end
end
return AssetModels
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="14">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[local Players=game:GetService("Players")
local RS=game:GetService("ReplicatedStorage")
local DataStoreService=game:GetService("DataStoreService")
local PathfindingService=game:GetService("PathfindingService")
local RunService=game:GetService("RunService")
local Config=require(RS.Shared.Config)
local Campaign=require(RS.Shared.Campaign)
local World=require(script.Parent.World)
local AssetModels=require(script.Parent.AssetModels)
local folder=Instance.new("Folder");folder.Name="BrambleRemotes";folder.Parent=RS
local action=Instance.new("RemoteEvent");action.Name="Action";action.Parent=folder
local update=Instance.new("RemoteEvent");update.Name="Update";update.Parent=folder
local sessions={}
local releaseHeld
local store=DataStoreService:GetDataStore(Config.SaveKey)
AssetModels.load()
World.build()
AssetModels.decorate(World)
local function snapshot(p,s,kind,message)
 update:FireClient(p,kind or "State",{state=s.state,active=s.active,scene=s.scene,dead=s.dead,stamina=s.stamina,message=message,saveStatus=s.saveStatus or "Sessão local",elapsed=s.elapsed,origin=World.Origins[s.state.sector]})
end
local function freeze(p,value)
 local c=p.Character;local root=c and c:FindFirstChild("HumanoidRootPart");local h=c and c:FindFirstChildOfClass("Humanoid")
 if root then root.Anchored=value end;if h then h.WalkSpeed=if value then 0 else 14;h.JumpPower=35;h.UseJumpPower=true end
end
local function removeEnemy(s) if s.enemy then s.enemy:Destroy();s.enemy=nil end;s.path=nil;s.memory=0;s.lastSeen=nil end
local function save(p,s)
 if s.saving then s.dirty=true;return end
 if not s.loaded then return end
 s.saving=true;s.dirty=false
 local record={state=s.state,elapsed=s.elapsed,savedAt=os.time()}
 task.spawn(function()
  local ok=pcall(function() store:UpdateAsync(tostring(p.UserId),function(old)
   if type(old)=="table" and type(old.savedAt)=="number" and old.savedAt>record.savedAt then return old end;return record
  end) end)
  s.saveStatus=if ok then "Checkpoint salvo" else "Checkpoint nesta sessão; salvamento online indisponível"
  s.saving=false
  if p.Parent then snapshot(p,s) end
  if s.dirty then save(p,s) end
 end)
end
local function beginScene(p,s,ending)
 s.scene=true;s.sceneToken+=1;freeze(p,true)
 if s.held then for side in pairs(s.held) do releaseHeld(s,side) end end
 snapshot(p,s,if ending then "Ending" else "Scene")
end
local function teleport(p,s)
 local c=p.Character;local root=c and c:FindFirstChild("HumanoidRootPart")
 if root then c:PivotTo(CFrame.new(World.Spawns[s.state.sector]));root.AssemblyLinearVelocity=Vector3.zero end
end
local function characterReady(p,c)
 local s=sessions[p];if not s then return end
 local h=c:WaitForChild("Humanoid",10);local root=c:WaitForChild("HumanoidRootPart",10);if not h or not root then return end
 task.wait(.2)
 if s.active then teleport(p,s) else c:PivotTo(CFrame.new(0,4,100)) end
 freeze(p,not s.active or s.scene or s.dead)
 h.Died:Connect(function() if sessions[p]~=s then return end;s.dead=true;s.active=false;removeEnemy(s);if s.held then for side in pairs(s.held) do releaseHeld(s,side) end end;snapshot(p,s,"Dead","A raiz encontrou você.") end)
 snapshot(p,s)
end
local function join(p)
 local s={owner=p,state=Campaign.new(),active=false,scene=false,sceneToken=0,dead=false,stamina=100,elapsed=0,lastAction=0,lastMove=0,run=false,crouch=false,loaded=false,dirty=false,memory=0,pathClock=0}
 sessions[p]=s
 p.CharacterAdded:Connect(function(c) characterReady(p,c) end)
 if p.Character then task.spawn(characterReady,p,p.Character) end
 task.spawn(function()
  local ok,record=pcall(function() return store:GetAsync(tostring(p.UserId)) end)
  if sessions[p]~=s then return end
  if ok and type(record)=="table" then s.state=Campaign.restore(record.state);s.elapsed=math.clamp(tonumber(record.elapsed) or 0,0,60*60*100) end
  s.loaded=true;s.saveStatus=if ok then "Progresso carregado" else "Salvamento online indisponível; progresso nesta sessão"
  if p.Parent then snapshot(p,s,"Ready") end
 end)
end
Players.PlayerAdded:Connect(join);for _,p in ipairs(Players:GetPlayers()) do join(p) end
Players.PlayerRemoving:Connect(function(p) local s=sessions[p];if s then save(p,s);removeEnemy(s);if s.held then for side in pairs(s.held) do releaseHeld(s,side) end end end;sessions[p]=nil end)
local function interact(p,s,id,right,handAlreadyLaunched)
 if type(id)~="string" or #id>60 or type(right)~="boolean" then return end
 if not s.active or s.scene or s.dead or os.clock()-s.lastAction<Config.InteractionCooldown then return end
 local target=World.Targets[id];local root=p.Character and p.Character:FindFirstChild("HumanoidRootPart")
 if not target or not root or target:GetAttribute("Sector")~=s.state.sector then return end
 local head=p.Character:FindFirstChild("Head") or root
 local distance=(head.Position-target.Position).Magnitude
 if distance>Config.MaxReach then return end
 local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Exclude;params.FilterDescendantsInstances={p.Character,s.enemy}
 local hit=workspace:Raycast(head.Position,target.Position-head.Position,params)
 if hit and hit.Instance~=target and not hit.Instance:IsDescendantOf(target) then return end
 s.lastAction=os.clock()
 if not handAlreadyLaunched then update:FireClient(p,"Hand",{point=target.Position,right=right}) end
 local sector=s.state.sector
 task.delay(distance/100,function()
  if sessions[p]~=s or not s.active or s.scene or s.dead or sector~=s.state.sector or not root.Parent or (root.Position-target.Position).Magnitude>Config.MaxReach+4 then return end
  local command=target:GetAttribute("Action")
  if command=="protocol" then snapshot(p,s,"Document",Config.Sectors[sector].Protocol);return end
  local nextState,message,changed=Campaign.act(s.state,command,right)
  if changed then
   local oldSector=s.state.sector;s.state=nextState;save(p,s)
   if s.state.finished then removeEnemy(s);beginScene(p,s,true)
   elseif oldSector~=s.state.sector then removeEnemy(s);teleport(p,s);beginScene(p,s,false)
   else snapshot(p,s,"State",message) end
  else snapshot(p,s,"State",message) end
 end)
end
releaseHeld=function(s,side)
 local held=s.held and s.held[side]
 if held then
  if held.align then held.align:Destroy() end
  if held.attachment then held.attachment:Destroy() end
  if held.part and held.part.Parent then
   held.part:SetAttribute("HeldBy",nil)
   if held.canCollideOriginal~=nil then pcall(function() held.part.CanCollide=held.canCollideOriginal end) end
   pcall(function() held.part:SetNetworkOwnershipAuto() end)
  end
  s.held[side]=nil
  if s.owner and s.owner.Parent then update:FireClient(s.owner,"HandRelease",{right=side==2}) end
 end
end
local function fireHand(p,s,direction,right)
 if not s.active or s.scene or s.dead or type(right)~="boolean" or typeof(direction)~="Vector3" then return end
 if direction.X~=direction.X or direction.Y~=direction.Y or direction.Z~=direction.Z or direction.Magnitude<.5 or direction.Magnitude>2 then return end
 local side=if right then 2 else 1
 s.handClocks=s.handClocks or {0,0};s.held=s.held or {}
 if os.clock()-s.handClocks[side]<.4 then return end
 s.handClocks[side]=os.clock();local launchClock=s.handClocks[side]
 if s.held[side] then releaseHeld(s,side);return end
 local character=p.Character;local head=character and character:FindFirstChild("Head")
 if not head then return end
 local filter={p.Character,s.enemy}
 if s.held then for _,h in pairs(s.held) do if h.part and h.part.Parent then table.insert(filter,h.part) end end end
 local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Exclude;params.FilterDescendantsInstances=filter
 local hit=workspace:Raycast(head.Position,direction.Unit*Config.MaxReach,params)
 local point=if hit then hit.Position else head.Position+direction.Unit*Config.MaxReach
 update:FireClient(p,"Hand",{point=point,right=right})
 if not hit then return end
 local target=hit.Instance
 while target and target~=workspace do
  local id=target:GetAttribute("TargetId")
  if id then interact(p,s,id,right,true);return end
  target=target.Parent
 end
 local part=hit.Instance
 if part:IsA("BasePart") and part:GetAttribute("GrabMovable")==true and not part.Anchored and part.AssemblyMass<35 then
  task.delay((point-head.Position).Magnitude/100,function()
   if sessions[p]~=s or s.handClocks[side]~=launchClock or not s.active or s.scene or s.dead or not part.Parent or not head.Parent or (part.Position-head.Position).Magnitude>Config.MaxReach+4 then return end
   if part:GetAttribute("HeldBy") then return end
   part:SetAttribute("HeldBy",p.UserId)
   local origCollide=part.CanCollide
   pcall(function() part.CanCollide=false end)
   local attachment=Instance.new("Attachment");attachment.Parent=part
   local align=Instance.new("AlignPosition");align.Mode=Enum.PositionAlignmentMode.OneAttachment;align.Attachment0=attachment;align.MaxForce=12000;align.MaxVelocity=25;align.Responsiveness=18;align.Position=head.Position+direction.Unit*6;align.Parent=part
   pcall(function() part:SetNetworkOwner(nil) end)
   s.held[side]={part=part,attachment=attachment,align=align,canCollideOriginal=origCollide}
   update:FireClient(p,"HandHold",{part=part,right=right})
  end)
 end
end
for id,target in pairs(World.Targets) do target:FindFirstChildOfClass("ProximityPrompt").Triggered:Connect(function(p) local s=sessions[p];if s then interact(p,s,id,false) end end) end
-- Remote requests never accept a client-provided state, position, inventory or completion flag.
action.OnServerEvent:Connect(function(p,verb,arg,extra)
 local s=sessions[p];if not s or type(verb)~="string" then return end
 if verb=="Sync" then snapshot(p,s,if s.loaded then "Ready" else "State");return end
 if verb=="Move" then
  if os.clock()-s.lastMove<.1 then return end;s.lastMove=os.clock()
  if type(arg)=="table" then s.run=arg.run==true;s.crouch=arg.crouch==true end;return
 end
 if verb=="Interact" then interact(p,s,arg,extra);return end
 if verb=="FireHand" then fireHand(p,s,arg,extra);return end
 if verb=="SceneDone" then
  if not s.scene then return end;s.scene=false
  if s.state.finished then s.active=false;freeze(p,true);snapshot(p,s,"Won") else freeze(p,false);snapshot(p,s) end;return
 end
 if verb=="Pause" then if not s.active or s.scene then return end;s.active=false;freeze(p,true);snapshot(p,s,"Paused");return end
 if verb=="Resume" then if s.dead or s.state.finished or s.scene then return end;s.active=true;freeze(p,false);snapshot(p,s);return end
 if verb=="Quit" then p:Kick("Bramble’s Sprout — até a próxima transmissão.");return end
 if verb~="Start" or not s.loaded or os.clock()-s.lastAction<.5 then return end
 s.lastAction=os.clock();removeEnemy(s)
 if arg~=false and s.state.finished then snapshot(p,s,"Won");return end
 if arg==false then s.state=Campaign.new();s.elapsed=0 end
 s.dead=false;s.active=true;s.stamina=100;s.run=false;s.crouch=false
 local h=p.Character and p.Character:FindFirstChildOfClass("Humanoid")
 if not h or h.Health<=0 then p:LoadCharacterAsync();task.wait(.3) end
 teleport(p,s)
 if arg==false then beginScene(p,s,false) else s.scene=false;freeze(p,false);snapshot(p,s) end
 save(p,s)
end)
local tickClock=0;local saveClock=0
RunService.Heartbeat:Connect(function(dt)
 tickClock+=dt;saveClock+=dt
 local broadcast=tickClock>=.25;if broadcast then tickClock=0 end
 for p,s in pairs(sessions) do
  if s.held then
   for side,held in pairs(s.held) do
    local head=p.Character and p.Character:FindFirstChild("Head")
    if not s.active or s.scene or s.dead or not head or not held.part.Parent or (head.Position-held.part.Position).Magnitude>Config.MaxReach+5 then
     if held.part.Parent then held.part:SetAttribute("HeldBy",nil) end;releaseHeld(s,side)
    else held.align.Position=head.Position+head.CFrame.LookVector*6+head.CFrame.RightVector*(if side==1 then -1 else 1) end
   end
  end
  if s.active and not s.scene and not s.dead then
   s.elapsed+=dt
   local character=p.Character;local humanoid=character and character:FindFirstChildOfClass("Humanoid");local root=character and character:FindFirstChild("HumanoidRootPart")
   if humanoid and root then
    local running=s.run and not s.crouch and s.stamina>1 and humanoid.MoveDirection.Magnitude>.1
    s.stamina=math.clamp(s.stamina+(if running then -20 else 13)*dt,0,100)
    humanoid.WalkSpeed=if s.crouch then 7 else if running then 23 else 14
    humanoid.CameraOffset=Vector3.new(0,if s.crouch then -1.2 else 0,0)
    if Campaign.danger(s.state) then
     if not s.enemy then s.enemy=World.createEnemy(workspace,World.EnemySpawns[s.state.sector]);s.pathClock=0 end
     local pos=s.enemy:GetPivot().Position;local gap=(root.Position-pos).Magnitude
     local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Exclude;params.FilterDescendantsInstances={s.enemy,character}
     local sight=workspace:Raycast(pos+Vector3.new(0,2,0),root.Position-pos,params)
     if (not sight and gap<(if s.crouch then 25 else 90)) or (running and gap<55) or gap<9 then s.lastSeen=root.Position;s.memory=5.5 else s.memory=math.max(0,s.memory-dt) end
     s.pathClock-=dt
     if s.pathClock<=0 and s.memory>0 and not s.pathBusy then
      s.pathClock=1.5;s.pathBusy=true;local model=s.enemy;local goal=s.lastSeen
      task.spawn(function()
       local path=PathfindingService:CreatePath({AgentRadius=2.1,AgentHeight=9,AgentCanJump=false,WaypointSpacing=5})
       local ok=pcall(function() path:ComputeAsync(pos,goal) end)
       if s.enemy==model and ok and path.Status==Enum.PathStatus.Success then s.path=path:GetWaypoints();s.waypoint=2 end;s.pathBusy=false
      end)
     end
     if s.path and s.path[s.waypoint] and s.memory>0 then
      local point=s.path[s.waypoint].Position;local delta=Vector3.new(point.X-pos.X,0,point.Z-pos.Z)
      if delta.Magnitude<2 then s.waypoint+=1 else
       local step=delta.Unit*math.min(delta.Magnitude,16*dt)
       local obstacle=workspace:Raycast(pos,pos+step-pos,params)
       if not obstacle then local nextPos=pos+step;s.enemy:PivotTo(CFrame.lookAt(nextPos,nextPos+delta.Unit)) end
      end
     end
     if gap<5 and not sight then s.dead=true;s.active=false;freeze(p,true);removeEnemy(s);snapshot(p,s,"Dead","Ele encontrou você. Retome o checkpoint.") end
    elseif s.enemy then removeEnemy(s) end
   end
  end
  if broadcast and s.active and not s.scene then snapshot(p,s) end
  if saveClock>=30 and s.loaded and s.active then save(p,s) end
 end
 if saveClock>=30 then saveClock=0 end
end)
game:BindToClose(function() for p,s in pairs(sessions) do save(p,s) end;local deadline=os.clock()+8;repeat local pending=false;for _,s in pairs(sessions) do if s.saving then pending=true end end;if not pending then break end;task.wait(.1) until os.clock()>deadline end)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">World</string>
          <string name="Source"><![CDATA[local RS=game:GetService("ReplicatedStorage")
local Config=require(RS.Shared.Config)
local Maze=require(RS.Shared.Maze)
local World={Targets={},Origins={},Spawns={},EnemySpawns={}}
local palettes={Color3.fromRGB(38,62,51),Color3.fromRGB(72,53,38),Color3.fromRGB(43,57,65),Color3.fromRGB(36,58,29),Color3.fromRGB(42,49,66),Color3.fromRGB(63,37,27),Color3.fromRGB(42,58,68)}
function World.part(parent,name,size,cf,color,material,collide)
 local p=Instance.new("Part");p.Name=name;p.Size=size;p.CFrame=cf;p.Color=color or Color3.fromRGB(51,57,54);p.Material=material or Enum.Material.Concrete;p.Anchored=true;p.CanCollide=collide~=false;p.TopSurface=Enum.SurfaceType.Smooth;p.BottomSurface=Enum.SurfaceType.Smooth;p.Parent=parent;return p
end
function World.label(p,text,size)
 local gui=Instance.new("SurfaceGui");gui.Face=Enum.NormalId.Back;gui.CanvasSize=Vector2.new(700,180);gui.Parent=p
 local t=Instance.new("TextLabel");t.Size=UDim2.fromScale(1,1);t.BackgroundTransparency=1;t.Text=text;t.TextColor3=Color3.fromRGB(222,229,212);t.Font=Enum.Font.Code;t.TextScaled=true;t.TextWrapped=true;t.Parent=gui
 local limit=Instance.new("UITextSizeConstraint");limit.MaxTextSize=size or 48;limit.Parent=t
 return t
end
local function block(parent,name,pos,size,color,material,collide) return World.part(parent,name,size,CFrame.new(pos),color,material,collide) end
function World.target(folder,sector,id,pos,title,color)
 local old=World.Targets[sector..":"..id];if old then old:Destroy();if World.Index and World.Index:FindFirstChild(sector..":"..id) then World.Index[sector..":"..id]:Destroy() end end
 local p=block(folder,id,pos,Vector3.new(2.6,3,0.8),Color3.fromRGB(33,40,40),Enum.Material.Metal,true)
 p:SetAttribute("TargetId",sector..":"..id);p:SetAttribute("Sector",sector);p:SetAttribute("Action",id);p:SetAttribute("Title",title)
 local lamp=block(p,"Indicator",pos+Vector3.new(0,-0.6,0.5),Vector3.new(1,0.45,0.12),color or Color3.fromRGB(63,174,189),Enum.Material.Neon,false)
 lamp.CastShadow=false
 local display=World.label(p,title,28);display.Name="Readout"
 local prompt=Instance.new("ProximityPrompt");prompt.Enabled=false;prompt.ActionText="Mão azul / E";prompt.ObjectText=title;prompt.MaxActivationDistance=12;prompt.RequiresLineOfSight=true;prompt.HoldDuration=0.3;prompt.Parent=p
 World.Targets[sector..":"..id]=p
 if World.Index then local ref=Instance.new("ObjectValue");ref.Name=sector..":"..id;ref.Value=p;ref.Parent=World.Index end
 return p
end
function World.light(folder,pos,color)
 local fixture=block(folder,"Luminária",pos,Vector3.new(8,.2,1),color or Color3.fromRGB(192,217,205),Enum.Material.Neon,false)
 local l=Instance.new("PointLight");l.Brightness=1.3;l.Range=38;l.Color=fixture.Color;l.Shadows=false;l.Parent=fixture
 return fixture
end
function World.createEnemy(parent,at)
 local assets=RS:FindFirstChild("BrambleAssets")
 local template=game:GetService("ServerStorage"):FindFirstChild("BrambleTemplate") or (assets and assets:FindFirstChild("BrambleTemplate"))
 if template and template:IsA("Model") then
  local imported=template:Clone();imported.Name="Bramble_Imported"
  for _,item in ipairs(imported:GetDescendants()) do
   if item:IsA("LuaSourceContainer") then item:Destroy()
   elseif item:IsA("BasePart") then item.Anchored=true;item.CanCollide=false;item.CanTouch=false end
  end
  local size=imported:GetExtentsSize();if size.Y>0 then imported:ScaleTo(imported:GetScale()*11/size.Y) end
  imported.Parent=parent;imported:PivotTo(CFrame.new(at));return imported
 end
 -- Original procedural placeholder. No Creator Store scripts execute at runtime.
 local m=Instance.new("Model");m.Name="Bramble_Placeholder";m.Parent=parent
 local core=block(m,"Root",at,Vector3.new(3,4,2),Color3.fromRGB(41,47,24),Enum.Material.Wood,false);m.PrimaryPart=core
 local head=block(m,"Head",at+Vector3.new(0,3,0),Vector3.new(4,3.6,3),Color3.fromRGB(48,61,31),Enum.Material.Wood,false);head.Shape=Enum.PartType.Ball
 for _,x in ipairs({-1.1,1.1}) do local eye=block(m,"Eye",at+Vector3.new(x,3.5,-1.45),Vector3.new(.55,.55,.2),Color3.fromRGB(237,214,135),Enum.Material.Neon,false);eye.Shape=Enum.PartType.Ball end
 for _,x in ipairs({-1.7,1.7}) do
  block(m,"Arm",at+Vector3.new(x,0,-.4),Vector3.new(.6,6,.7),Color3.fromRGB(54,62,31),Enum.Material.Wood,false)
  block(m,"Leg",at+Vector3.new(x*.6,-3,0),Vector3.new(.8,4,.8),Color3.fromRGB(31,37,18),Enum.Material.Wood,false)
 end
 for i=1,7 do local spike=block(m,"Thorn",at+Vector3.new((i-4)*.7,5,0),Vector3.new(.25,2+(i%3),.25),Color3.fromRGB(64,74,36),Enum.Material.Wood,false);spike.CFrame*=CFrame.Angles(0,0,(i-4)*.12) end
 return m
end
function World.build()
 local previous=workspace:FindFirstChild("BrambleWorld")
 if previous and previous:GetAttribute("Prebuilt") then
  for sector=1,7 do local o=Vector3.new((sector-1)*650,0,-100);World.Origins[sector]=o;World.Spawns[sector]=o+Vector3.new(0,4,0);World.EnemySpawns[sector]=o+Vector3.new(0,5,-210) end
  World.Spawns[4]=World.Origins[4]+Vector3.new(-63,4,-15);World.EnemySpawns[4]=World.Origins[4]+Vector3.new(-63,5,-15)
  World.Index=previous:FindFirstChild("TargetIndex")
  for _,item in ipairs(previous:GetDescendants()) do local id=item:GetAttribute("TargetId");if id and item:FindFirstChildOfClass("ProximityPrompt") then World.Targets[id]=item end end
  workspace:SetAttribute("BrambleWorldReady",true);return World
 end
 if previous then previous:Destroy() end
 local root=Instance.new("Folder");root.Name="BrambleWorld";root.Parent=workspace
 World.Index=Instance.new("Folder");World.Index.Name="TargetIndex";World.Index.Parent=root
 local lobby=Instance.new("Folder");lobby.Name="MenuSet";lobby.Parent=root
 block(lobby,"Stage",Vector3.new(0,-1,80),Vector3.new(110,2,90),Color3.fromRGB(22,24,24),Enum.Material.Concrete)
 block(lobby,"BackWall",Vector3.new(0,15,50),Vector3.new(110,30,2),Color3.fromRGB(25,29,27))
 World.light(lobby,Vector3.new(10,14,65),Color3.fromRGB(183,45,20));World.light(lobby,Vector3.new(-10,10,80),Color3.fromRGB(43,99,110))
 World.createEnemy(lobby,Vector3.new(6,6,67))
 local spawn=Instance.new("SpawnLocation");spawn.Name="SafeSpawn";spawn.Size=Vector3.new(8,1,8);spawn.CFrame=CFrame.new(0,1,100);spawn.Anchored=true;spawn.Transparency=1;spawn.CanCollide=false;spawn.Neutral=true;spawn.Parent=lobby
 for sector,info in ipairs(Config.Sectors) do
  local o=Vector3.new((sector-1)*650,0,-100);World.Origins[sector]=o;World.Spawns[sector]=o+Vector3.new(0,4,0);World.EnemySpawns[sector]=o+Vector3.new(0,5,-210)
  local f=Instance.new("Folder");f.Name=string.format("%02d_%s",sector,info.Name);f.Parent=root;local color=palettes[sector]
  for z=0,8 do
   local tile=block(f,"Floor",o+Vector3.new(0,-1,-z*30),Vector3.new(160,2,30),Color3.fromRGB(78,82,75),Enum.Material.Concrete)
   block(f,"Stripe",tile.CFrame.Position+Vector3.new(0,1.02,0),Vector3.new(1,.04,30),Color3.fromRGB(151,115,43),Enum.Material.Metal,false)
   block(f,"Beam",o+Vector3.new(0,17,-z*30),Vector3.new(160,1,1),Color3.fromRGB(34,40,39),Enum.Material.Metal,false)
   World.light(f,o+Vector3.new(0,16,-z*30))
   for _,side in ipairs({-1,1}) do
    block(f,"Pipe",o+Vector3.new(side*77,12,-z*30),Vector3.new(.7,.7,30),Color3.fromRGB(78,88,86),Enum.Material.Metal,false)
    block(f,"Skirting",o+Vector3.new(side*79,3,-z*30),Vector3.new(.2,.5,30),Color3.fromRGB(116,54,29),Enum.Material.Metal,false)
   end
  end
  block(f,"Ceiling",o+Vector3.new(0,19,-120),Vector3.new(160,1,270),Color3.fromRGB(17,23,23))
  for _,side in ipairs({-1,1}) do block(f,"Wall",o+Vector3.new(side*80,9,-120),Vector3.new(2,20,270),color) end
  block(f,"EndWall",o+Vector3.new(0,9,-255),Vector3.new(160,20,2),color)
  block(f,"EntryWall",o+Vector3.new(0,9,15),Vector3.new(160,20,2),color)
  local sign=block(f,"SectorSign",o+Vector3.new(0,12,-25),Vector3.new(30,4,.2),color,Enum.Material.Metal,false);World.label(sign,info.Name,40)
  World.target(f,sector,"protocol",o+Vector3.new(5,4,-8),"LER PROTOCOLO",Color3.fromRGB(213,183,118))
  World.target(f,sector,"exit",o+Vector3.new(0,4,-244),if sector==7 then "ENTRAR NO ELEVADOR" else "PRÓXIMO SETOR",Color3.fromRGB(198,125,47))
  local function target(id,x,z,title,c) return World.target(f,sector,id,o+Vector3.new(x,4,z),title,c) end
  if sector==1 then
   for _,side in ipairs({-1,1}) do
    for z=45,195,50 do
     block(f,"Partition",o+Vector3.new(side*35,6,-z),Vector3.new(2,12,28),color)
     block(f,"Desk",o+Vector3.new(side*55,2,-z+4),Vector3.new(20,4,5),Color3.fromRGB(65,48,31),Enum.Material.Wood)
    end
   end
   target("card",-55,-30,"CRACHÁ");target("fuse",48,-38,"FUSÍVEL");target("power",40,-70,"QUADRO PRINCIPAL")
   target("socket1",-44,-105,"TERMINAL 1 / AZUL",Color3.fromRGB(35,100,230));target("socket2",45,-135,"TERMINAL 2 / VERMELHA",Color3.fromRGB(220,40,25))
   for i=1,3 do target("bloom"..i,-50+(i-1)*50,-175,"PODAR FLOR "..i,Color3.fromRGB(143,91,47)) end
   target("socket3",40,-207,"TERMINAL 3 / AZUL");target("release",-30,-225,"LIBERAÇÃO / VERMELHA")
  elseif sector==2 then
   for _,x in ipairs({-65,-40,40,65}) do for z=55,210,25 do block(f,"Bookcase",o+Vector3.new(x,5,-z),Vector3.new(9,10,3),Color3.fromRGB(52,36,23),Enum.Material.Wood)
    for shelf=1,3 do for book=1,5 do block(f,"Book",o+Vector3.new(x-3+book, shelf*2.5,-z-2),Vector3.new(.6,2,1),Color3.fromHSV((book+shelf)*.04,.4,.35),Enum.Material.Fabric,false) end end
   end end
   target("page1",-65,-42,"PÁGINA 1");target("page2",65,-142,"PÁGINA 2");target("page3",-36,-212,"PÁGINA 3")
   for i=1,4 do target("digit"..i,-15+(i-1)*10,-224,"DÍGITO "..i) end;target("safe",0,-235,"ABRIR COFRE")
  elseif sector==3 then
   for _,side in ipairs({-1,1}) do for z=50,220,35 do block(f,"Generator",o+Vector3.new(side*58,4,-z),Vector3.new(12,8,12),Color3.fromRGB(34,42,45),Enum.Material.Metal)
    local motor=block(f,"Motor",o+Vector3.new(side*58,10,-z),Vector3.new(5,8,5),Color3.fromRGB(85,72,43),Enum.Material.Metal,false);motor.Shape=Enum.PartType.Cylinder
   end end
   local names={"ENTRADA","DESVIO","RETORNO","RESERVA"};for i=1,4 do target("valve"..i,-45+(i-1)*30,-92,names[i]) end
   target("pressure",0,-150,"PRESSÃO");for i=1,3 do target("cell"..i,if i%2==1 then -70 else 70,-35-i*45,"CÉLULA "..i) end;target("start",0,-225,"PARTIDA / VERMELHA")
  elseif sector==4 then
   local cells,leaves=Maze.generate(10,16,58817);local spacing=14
   for y=1,16 do for x=1,10 do
    local c=o+Vector3.new(-63+(x-1)*spacing,4,-15-(y-1)*spacing)
    if cells[y][x][1] then block(f,"Hedge",c+Vector3.new(0,0,7),Vector3.new(14,8,1),color,Enum.Material.Grass) end
    if cells[y][x][4] then block(f,"Hedge",c+Vector3.new(-7,0,0),Vector3.new(1,8,14),color,Enum.Material.Grass) end
    if y==16 then block(f,"Hedge",c+Vector3.new(0,0,-7),Vector3.new(14,8,1),color,Enum.Material.Grass) end
    if x==10 then block(f,"Hedge",c+Vector3.new(7,0,0),Vector3.new(1,8,14),color,Enum.Material.Grass) end
   end end
   for i=1,6 do local cell=leaves[math.floor((i-1)*#leaves/6)+1];target("seed"..i,-63+(cell[1]-1)*14,-15-(cell[2]-1)*14,"SEMENTE "..i,Color3.fromRGB(223,151,55)) end
   World.Spawns[sector]=o+Vector3.new(-63,4,-15);World.EnemySpawns[sector]=o+Vector3.new(-63,5,-15)
   local exit=World.Targets[sector..":exit"];local delta=o+Vector3.new(63,4,-225)-exit.CFrame.Position;exit.CFrame+=delta;for _,part in ipairs(exit:GetChildren()) do if part:IsA("BasePart") then part.CFrame+=delta end end
   target("protocol",-60,-11,"LER PROTOCOLO")
  elseif sector==5 then
   for i=1,4 do target("tone"..i,-30+(i-1)*20,-95,"TOM "..i) end
   for i=1,9 do local p=target("lamp"..i,-12+((i-1)%3)*12,-205,"MATRIZ "..i);local shift=Vector3.new(0,math.floor((i-1)/3)*5,0);p.CFrame+=shift;for _,part in ipairs(p:GetChildren()) do if part:IsA("BasePart") then part.CFrame+=shift end end end
   for _,x in ipairs({-60,60}) do for z=60,210,25 do block(f,"TapeRack",o+Vector3.new(x,5,-z),Vector3.new(10,10,5),Color3.fromRGB(25,30,34),Enum.Material.Metal) end end
  elseif sector==6 then
   local rootBall=block(f,"RootCore",o+Vector3.new(0,4,-135),Vector3.new(24,8,24),Color3.fromRGB(49,29,18),Enum.Material.Wood);rootBall.Shape=Enum.PartType.Ball
   for i=1,12 do local a=i*math.pi/6;local vine=block(f,"Root",o+Vector3.new(math.cos(a)*25,1,-135+math.sin(a)*25),Vector3.new(55,1.5,2),Color3.fromRGB(56,36,23),Enum.Material.Wood,false);vine.CFrame*=CFrame.Angles(0,-a,0) end
   for i=1,4 do local x=if i%2==1 then -55 else 55;local z=-25-i*45;target("isolate"..i,x,z,"ISOLAR "..i.." / AZUL");target("cut"..i,x,z-10,"CORTAR "..i.." / VERMELHA",Color3.fromRGB(225,35,26)) end
  else
   for i=1,4 do target("fuse"..i,if i%2==1 then -65 else 65,-25-i*42,"FUSÍVEL "..i) end
   for i=1,3 do local x=-25+(i-1)*25;target("angle"..i,x,-210,"ANTENA "..i)
    block(f,"Mast",o+Vector3.new(x,7,-220),Vector3.new(.7,14,.7),Color3.fromRGB(91,102,108),Enum.Material.Metal,false)
    local dish=block(f,"Antenna"..i,o+Vector3.new(x,13,-220),Vector3.new(12,12,2),Color3.fromRGB(116,126,128),Enum.Material.Metal,false);dish.Shape=Enum.PartType.Cylinder;dish.CFrame*=CFrame.Angles(0,0,math.pi/2);dish:SetAttribute("Antenna",i);dish:SetAttribute("Sector",sector)
   end;target("master",0,-233,"CHAVE MESTRE / VERMELHA",Color3.fromRGB(225,35,26))
  end
 end
 workspace:SetAttribute("BrambleWorldReady",true)
 return World
end
return World
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="16">
    <Properties>
      <string name="Name">SoundService</string>
      <bool name="RespectFilteringEnabled">true</bool>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="17">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <token name="CameraMode">1</token>
      <float name="CharacterJumpPower">35</float>
      <float name="CharacterWalkSpeed">14</float>
      <bool name="EnableMouseLockOption">false</bool>
    </Properties>
    <Item class="StarterPlayerScripts" referent="18">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="19">
        <Properties>
          <string name="Name">BrambleClient</string>
        </Properties>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">Hands</string>
            <string name="Source"><![CDATA[local RunService=game:GetService("RunService")
local Hands={}
function Hands.new(camera)
 local self=setmetatable({camera=camera,models={},flights={},enabled=false},{__index=Hands})
 self.root=Instance.new("Folder");self.root.Name="BrambleViewmodel";self.root.Parent=camera
 local function part(parent,name,size,cf,color,material)
  local p=Instance.new("Part");p.Name=name;p.Size=size;p.CFrame=cf;p.Color=color;p.Material=material or Enum.Material.SmoothPlastic;p.Anchored=true;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false;p.CastShadow=false;p.Parent=parent;return p
 end
 for side=1,2 do
  local m=Instance.new("Model");m.Name=if side==1 then "BlueHand" else "RedHand";m.Parent=self.root
  local color=if side==1 then Color3.fromRGB(26,78,196) else Color3.fromRGB(169,36,28)
  local assets=game:GetService("ReplicatedStorage"):FindFirstChild("BrambleAssets")
  local template=assets and assets:FindFirstChild(if side==1 then "BlueHand" else "RedHand")
  local palm
  if template then
   m:Destroy();m=template:Clone();m.Name=if side==1 then "BlueHand" else "RedHand";m.Parent=self.root
   local size=m:GetExtentsSize();m:ScaleTo(m:GetScale()*1.25/math.max(size.X,size.Y,size.Z))
   local center=m:GetBoundingBox();m.WorldPivot=center
   palm=m:FindFirstChildWhichIsA("BasePart",true)
   for _,p in ipairs(m:GetDescendants()) do if p:IsA("BasePart") then p.Anchored=true;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false;p.CastShadow=false end end
  else
  palm=part(m,"Palm",Vector3.new(.6,.64,.22),CFrame.new(),color);m.PrimaryPart=palm
  for finger=1,4 do
   local length=({.42,.52,.49,.37})[finger]
   part(m,"Finger"..finger,Vector3.new(.12,length,.16),CFrame.new(-.24+(finger-1)*.16,.32+length/2,0),color)
  end
  part(m,"Thumb",Vector3.new(.16,.43,.18),CFrame.new(if side==1 then .38 else -.38,.02,0)*CFrame.Angles(0,0,if side==1 then -.6 else .6),color)
  part(m,"Cuff",Vector3.new(.49,.22,.28),CFrame.new(0,-.45,0),Color3.fromRGB(174,126,27),Enum.Material.Metal)
  end
  local from=part(self.root,"Wrist",Vector3.new(.02,.02,.02),CFrame.new(),color);from.Transparency=1
  local a=Instance.new("Attachment");a.Parent=from;local b=Instance.new("Attachment");b.Parent=palm
  local beam=Instance.new("Beam");beam.Attachment0=a;beam.Attachment1=b;beam.Width0=.025;beam.Width1=.025;beam.FaceCamera=true;beam.Color=ColorSequence.new(Color3.fromRGB(29,32,29));beam.Enabled=false;beam.Parent=from
  self.models[side]={model=m,from=from,beam=beam}
 end
 self.connection=RunService.RenderStepped:Connect(function()
  for side,item in ipairs(self.models) do
   local base=self.camera.CFrame*CFrame.new(if side==1 then -.88 else .88,-.62,-1.65)
   local flight=self.flights[side];local at=base
   if flight then
    local age=os.clock()-flight.start;local travel=flight.travel;local t=if age<travel then age/travel else 1-math.clamp((age-travel-.12)/travel,0,1)
    local position=base.Position:Lerp(flight.point,t)
    if flight.held and flight.held.Parent then position=flight.held.Position end
    at=CFrame.new(position)*base.Rotation
    if (not flight.held or not flight.held.Parent) and age>travel*2+.12 then self.flights[side]=nil end
   end
   item.model:PivotTo(at);item.from.CFrame=base*CFrame.new(0,-.45,.2);item.beam.Enabled=self.enabled and self.flights[side]~=nil
   for _,p in ipairs(item.model:GetDescendants()) do if p:IsA("BasePart") then p.LocalTransparencyModifier=if self.enabled then 0 else 1 end end
  end
 end)
 return self
end
function Hands:launch(point,right) self.flights[if right then 2 else 1]={point=point,start=os.clock(),travel=math.clamp((point-self.camera.CFrame.Position).Magnitude/100,.08,.65)} end
function Hands:hold(part,right) if typeof(part)=="Instance" and part:IsA("BasePart") then self.flights[if right then 2 else 1]={held=part,point=part.Position,start=os.clock(),travel=.1} end end
function Hands:release(right) local side=if right then 2 else 1;local flight=self.flights[side];if flight then local point=if flight.held and flight.held.Parent then flight.held.Position else flight.point;local travel=math.clamp((point-self.camera.CFrame.Position).Magnitude/100,.08,.65);self.flights[side]={point=point,start=os.clock()-travel-.12,travel=travel} end end
function Hands:setEnabled(enabled) self.enabled=enabled;if not enabled then self.flights={} end end
function Hands:destroy() self.connection:Disconnect();self.root:Destroy() end
return Hands
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="21">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[local Players=game:GetService("Players")
local RS=game:GetService("ReplicatedStorage")
local UIS=game:GetService("UserInputService")
local TweenService=game:GetService("TweenService")
local RunService=game:GetService("RunService")
local SoundService=game:GetService("SoundService")
local Lighting=game:GetService("Lighting")
local player=Players.LocalPlayer
local Config=require(RS:WaitForChild("Shared"):WaitForChild("Config"))
local Campaign=require(RS.Shared.Campaign)
local remotes=RS:WaitForChild("BrambleRemotes")
local action,update=remotes:WaitForChild("Action"),remotes:WaitForChild("Update")
local Hands=require(script.Parent.Hands)
local camera=workspace.CurrentCamera
local assets=RS:WaitForChild("BrambleAssets",30)
if assets then local deadline=os.clock()+30;while not assets:GetAttribute("Ready") and os.clock()<deadline do task.wait(.1) end end
local hands=Hands.new(camera)
local gui=Instance.new("ScreenGui");gui.Name="BramblesSprout";gui.ResetOnSpawn=false;gui.IgnoreGuiInset=true;gui.Enabled=false;gui.Parent=player:WaitForChild("PlayerGui")
local root=Instance.new("Frame");root.Size=UDim2.fromOffset(1280,720);root.AnchorPoint=Vector2.new(.5,.5);root.Position=UDim2.fromScale(.5,.5);root.BackgroundTransparency=1;root.Parent=gui
local scale=Instance.new("UIScale");scale.Parent=root
local function resize() local size=camera.ViewportSize;scale.Scale=math.min(size.X/1280,size.Y/720) end
camera:GetPropertyChangedSignal("ViewportSize"):Connect(resize);resize()
local function frame(parent,name,pos,size,color,transparency)
 local f=Instance.new("Frame");f.Name=name;f.Position=UDim2.fromOffset(pos.X,pos.Y);f.Size=UDim2.fromOffset(size.X,size.Y);f.BorderSizePixel=0;f.BackgroundColor3=color or Color3.new(0,0,0);f.BackgroundTransparency=transparency or 0;f.Parent=parent;return f
end
local function label(parent,text,pos,size,fontSize)
 local t=Instance.new("TextLabel");t.BackgroundTransparency=1;t.Position=UDim2.fromOffset(pos.X,pos.Y);t.Size=UDim2.fromOffset(size.X,size.Y);t.Text=text;t.TextColor3=Color3.fromRGB(230,230,216);t.Font=Enum.Font.Code;t.TextSize=fontSize or 22;t.TextXAlignment=Enum.TextXAlignment.Left;t.TextYAlignment=Enum.TextYAlignment.Top;t.TextWrapped=true;t.Parent=parent;return t
end
local function button(parent,text,pos,size,fn)
 local b=Instance.new("TextButton");b.Position=UDim2.fromOffset(pos.X,pos.Y);b.Size=UDim2.fromOffset(size.X,size.Y);b.BackgroundColor3=Color3.fromRGB(9,12,11);b.BackgroundTransparency=.3;b.BorderSizePixel=1;b.BorderColor3=Color3.fromRGB(112,119,111);b.TextColor3=Color3.fromRGB(228,232,218);b.Font=Enum.Font.Code;b.TextSize=21;b.Text=text;b.Parent=parent;b.Activated:Connect(fn);return b
end
local menu=frame(root,"Menu",Vector2.zero,Vector2.new(1280,720),Color3.new(0,0,0),.5)
local shade=frame(menu,"ReadingShade",Vector2.zero,Vector2.new(550,720),Color3.new(0,0,0),.12)
local chapter=label(menu,"BRAMBLE’S SPROUT / CAPÍTULO 1",Vector2.new(55,45),Vector2.new(600,35),24)
local heading=label(menu,"DEAD SIGNAL",Vector2.new(55,93),Vector2.new(680,70),45)
frame(menu,"Rule",Vector2.new(55,165),Vector2.new(460,1),Color3.fromRGB(109,117,109))
local description=label(menu,"Hora de podar.\nAs flores murcharam. O sinal continuou.",Vector2.new(55,195),Vector2.new(480,205),22)
local controls=frame(menu,"Buttons",Vector2.new(55,425),Vector2.new(405,280),nil,1)
local hud=frame(root,"HUD",Vector2.zero,Vector2.new(1280,720),nil,1);hud.Visible=false
local objective=label(hud,"",Vector2.new(24,25),Vector2.new(940,100),22)
local staminaBg=frame(hud,"StaminaBg",Vector2.new(24,135),Vector2.new(260,18),Color3.fromRGB(18,24,20),.4)
frame(staminaBg,"StaminaBorder",Vector2.new(-1,-1),Vector2.new(262,20),Color3.fromRGB(80,95,85),.7)
local staminaBar=frame(staminaBg,"StaminaBar",Vector2.zero,Vector2.new(260,18),Color3.fromRGB(80,200,120),.1)
local stamina=label(hud,"",Vector2.new(24,158),Vector2.new(460,35),16)
local prompt=label(hud,"",Vector2.new(220,470),Vector2.new(850,70),21);prompt.TextXAlignment=Enum.TextXAlignment.Center
local crosshair=label(hud,"·",Vector2.new(627,332),Vector2.new(28,35),30)
local status=label(menu,"Conectando ao servidor…",Vector2.new(55,685),Vector2.new(1050,30),16)
local cinema=frame(root,"Cinema",Vector2.zero,Vector2.new(1280,720),nil,1);cinema.Visible=false
frame(cinema,"TopBar",Vector2.zero,Vector2.new(1280,85));frame(cinema,"BottomBar",Vector2.new(0,610),Vector2.new(1280,110))
local caption=label(cinema,"",Vector2.new(95,635),Vector2.new(1090,75),24);caption.TextXAlignment=Enum.TextXAlignment.Center
local data={state=Campaign.new(),active=false,stamina=100,elapsed=0}
local mode="menu";local loaded=false;local sceneEpoch=0;local shotTween
local run=false;local crouch=false;local sensitivity=1;local volume=.75;local lowGraphics=false
local messageUntil=0;local message="";local function sound(id,loop,vol)
 if type(id)~="number" or id<=0 then return nil end
 local s=Instance.new("Sound");s.SoundId="rbxassetid://"..id;s.Looped=loop;s.Volume=vol or .4;s.Parent=SoundService;return s
end
local ambience=sound(Config.Assets.Ambient,true,.25);local pursuit=sound(Config.Assets.Pursuit,true,0);local voice;local radioSfx
if ambience then ambience:Play() end;if pursuit then pursuit:Play() end
local function stopVoice() if voice then voice:Stop();voice:Destroy();voice=nil end end
local function playVoice(id) stopVoice();voice=sound(id,false,.9*volume);if voice then voice:Play() end end
local function playRadioTape()
 if radioSfx then radioSfx:Destroy() end
 radioSfx=sound(Config.Assets.Radio,false,.6*volume)
 if radioSfx then radioSfx:Play() end
end
local function clearButtons() for _,b in ipairs(controls:GetChildren()) do b:Destroy() end end
local function add(text,index,fn) return button(controls,text,Vector2.new(0,(index-1)*46),Vector2.new(330,39),fn) end
local function mouse(free) UIS.MouseBehavior=if free then Enum.MouseBehavior.Default else Enum.MouseBehavior.LockCenter;UIS.MouseIconEnabled=free end
local function gameplay()
 mode="playing";menu.Visible=false;hud.Visible=true;cinema.Visible=false;hands:setEnabled(true)
 camera.CameraType=Enum.CameraType.Custom;player.CameraMode=Enum.CameraMode.LockFirstPerson
 local h=player.Character and player.Character:FindFirstChildOfClass("Humanoid");if h then camera.CameraSubject=h end;mouse(false)
end
local mainMenu
local function askNew()
 heading.Text="NOVO JOGO";description.Text="Isso substitui seu checkpoint atual. Começar de novo?";clearButtons()
 add("COMEÇAR",1,function() if loaded then action:FireServer("Start",false) end end);add("VOLTAR",2,mainMenu)
end
local function settings()
 heading.Text="CONFIGURAÇÕES";description.Text="Ajustes desta sessão. O progresso do capítulo é salvo pelo servidor.";clearButtons()
 add("VOLUME: "..math.floor(volume*100).."%",1,function() volume=(volume+.25)%1.25;if voice then voice.Volume=volume*.9 end;settings() end)
 add("SENSIBILIDADE: "..string.format("%.1f",sensitivity),2,function() sensitivity=if sensitivity>=1.5 then .5 else sensitivity+.25;UIS.MouseDeltaSensitivity=sensitivity;settings() end)
 add("GRÁFICOS: "..(if lowGraphics then "LEVE" else "NORMAL"),3,function() lowGraphics=not lowGraphics;Lighting.GlobalShadows=not lowGraphics;settings() end)
 add("VOLTAR",4,mainMenu)
end
mainMenu=function()
 mode="menu";menu.Visible=true;hud.Visible=false;cinema.Visible=false;hands:setEnabled(false);mouse(true)
 chapter.Text="BRAMBLE’S SPROUT / CAPÍTULO 1";heading.Text="DEAD SIGNAL";description.Text="Hora de podar.\nAs flores murcharam. O sinal continuou.\n\nVolte ao conservatório e corte o que não deveria crescer.";clearButtons()
 local cont=add(if data.dead then "RETOMAR CHECKPOINT" else "CONTINUAR",1,function()
  if not loaded or data.state.finished then return end
  if data.active==false and not data.dead and mode=="paused" then action:FireServer("Resume") else action:FireServer("Start",true) end
 end);cont.AutoButtonColor=loaded and not data.state.finished
 add("NOVO JOGO",2,askNew);add("CONFIGURAÇÕES",3,settings)
 add("CRÉDITOS",4,function() heading.Text="CRÉDITOS";description.Text="Aurivane Works\nBramble’s Sprout — Dead Signal\nPort nativo em Luau. Cenários e criatura provisória procedurais.\nVeja ASSETS.md para importações e créditos.";clearButtons();add("VOLTAR",1,mainMenu) end)
 add("SAIR",5,function() heading.Text="ENCERRAR SESSÃO?";description.Text="Seu último checkpoint continua salvo quando o armazenamento online está disponível.";clearButtons();add("SAIR DA EXPERIÊNCIA",1,function() action:FireServer("Quit") end);add("VOLTAR",2,mainMenu) end)
 camera.CameraType=Enum.CameraType.Scriptable;camera.CFrame=CFrame.lookAt(Vector3.new(-8,7,92),Vector3.new(6,7,67))
end
local function sceneDone()
 sceneEpoch+=1;if shotTween then shotTween:Cancel() end;stopVoice();cinema.Visible=false;action:FireServer("SceneDone")
end
button(cinema,"PULAR CENA ›",Vector2.new(1040,25),Vector2.new(190,45),sceneDone)
local function scene(payload,ending)
 sceneEpoch+=1;local token=sceneEpoch
 mode="cinema";menu.Visible=false;hud.Visible=false;cinema.Visible=true;hands:setEnabled(false);mouse(true);camera.CameraType=Enum.CameraType.Scriptable
 local sector=payload.state.sector;local o=payload.origin or Vector3.zero
 local lines=if ending then {"O ELEVADOR / 00:03","VOCÊ: Acabou. A antena está muda.","RÁDIO: Você não desligou o sinal. Você me levou com você."} else Config.Sectors[sector].Lines
 local shots={o+Vector3.new(10,8,-15),o+Vector3.new(-20,8,-100),o+Vector3.new(10,9,-220)}
 if sector==4 then shots={o+Vector3.new(-63,14,-15),o+Vector3.new(-15,14,-100),o+Vector3.new(50,14,-220)} end
 if ending then shots={o+Vector3.new(8,8,-240),o+Vector3.new(0,14,-235),o+Vector3.new(0,21,-240)} end
 if sector==1 and not ending then playVoice(Config.Assets.OpeningVoice) end
 for i=1,3 do
  if token~=sceneEpoch then return end
  caption.Text=lines[i]
  local key=(if ending then 7 else sector-1).."_"..(i-1)
  if (i>1 and sector~=1) or (ending and i>1) then playVoice(Config.Assets.Voices[key]) end
  camera.CFrame=CFrame.lookAt(shots[i],shots[i]+Vector3.new(0,-1,-20))
  local duration=if sector==1 and Config.Assets.OpeningVoice>0 and not ending then 11.3 else 4.8
  if voice then
   local deadline=os.clock()+3
   while not voice.IsLoaded and os.clock()<deadline do task.wait(.05);if token~=sceneEpoch then return end end
   if voice.IsLoaded then
    if sector==1 and not ending then duration=(voice.TimeLength+.5)/3 else duration=math.max(duration,voice.TimeLength+.4) end
   end
  end
  shotTween=TweenService:Create(camera,TweenInfo.new(duration,Enum.EasingStyle.Sine),{CFrame=camera.CFrame*CFrame.new(2,.3,-5)});shotTween:Play()
  local deadline=os.clock()+duration
  repeat task.wait(.05);if token~=sceneEpoch then return end until os.clock()>deadline
 end
 sceneDone()
end
local function targetAtCrosshair()
 local ray=camera:ViewportPointToRay(camera.ViewportSize.X/2,camera.ViewportSize.Y/2)
 local filter={player.Character,hands.root}
 if hands.flights then for _,f in pairs(hands.flights) do if f.held and f.held.Parent then table.insert(filter,f.held) end end end
 local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Exclude;params.FilterDescendantsInstances=filter
 local hit=workspace:Raycast(ray.Origin,ray.Direction*Config.MaxReach,params)
 local obj=hit and hit.Instance
 while obj and obj~=workspace do if obj:GetAttribute("TargetId") then return obj end;obj=obj.Parent end
 return nil
end
local function use(right)
 if mode~="playing" then return end
 local ray=camera:ViewportPointToRay(camera.ViewportSize.X/2,camera.ViewportSize.Y/2)
 action:FireServer("FireHand",ray.Direction,right)
end
local lamp
local function movement() action:FireServer("Move",{run=run,crouch=crouch}) end
local function pause() if mode=="playing" then run=false;movement();action:FireServer("Pause") end end
button(hud,"Ⅱ",Vector2.new(1190,20),Vector2.new(65,55),pause)
if UIS.TouchEnabled then
 button(hud,"AZUL",Vector2.new(230,550),Vector2.new(145,95),function() use(false) end)
 button(hud,"VERMELHA",Vector2.new(1050,430),Vector2.new(170,95),function() use(true) end)
 button(hud,"CORRER",Vector2.new(230,450),Vector2.new(145,65),function() run=not run;movement() end)
 button(hud,"LUZ",Vector2.new(1100,360),Vector2.new(120,65),function() if lamp then lamp.Enabled=not lamp.Enabled end end)
 button(hud,"AGACHAR",Vector2.new(900,550),Vector2.new(150,65),function() crouch=not crouch;movement() end)
end
local function character(c)
 local head=c:WaitForChild("Head",10);if head then lamp=Instance.new("SpotLight");lamp.Face=Enum.NormalId.Front;lamp.Range=65;lamp.Angle=60;lamp.Brightness=2;lamp.Shadows=false;lamp.Parent=head end
end
player.CharacterAdded:Connect(character);if player.Character then task.spawn(character,player.Character) end
UIS.InputBegan:Connect(function(input,processed)
 if processed then return end
 if input.KeyCode==Enum.KeyCode.E or input.UserInputType==Enum.UserInputType.MouseButton1 then use(false)
 elseif input.KeyCode==Enum.KeyCode.Q or input.UserInputType==Enum.UserInputType.MouseButton2 then use(true)
 elseif input.KeyCode==Enum.KeyCode.LeftShift then run=true;movement()
 elseif input.KeyCode==Enum.KeyCode.C then crouch=not crouch;movement()
 elseif input.KeyCode==Enum.KeyCode.F and lamp then lamp.Enabled=not lamp.Enabled
 elseif input.KeyCode==Enum.KeyCode.P then pause() end
end)
UIS.InputEnded:Connect(function(input) if input.KeyCode==Enum.KeyCode.LeftShift then run=false;movement() end end)
local lastVisual=""
local function refreshWorld()
 local st=data.state
 local signature=game:GetService("HttpService"):JSONEncode(st)
 if signature==lastVisual then return end;lastVisual=signature
 local world=workspace:FindFirstChild("BrambleWorld");local index=world and world:FindFirstChild("TargetIndex");if not index then lastVisual="";return end
 for _,ref in ipairs(index:GetChildren()) do
  local target=ref.Value
  if target and target:GetAttribute("Sector")==st.sector then
   local id=target:GetAttribute("Action");local collected=st.flags[id] and (string.match(id,"^page") or string.match(id,"^seed") or string.match(id,"^cell") or string.match(id,"^fuse") or id=="card" or string.match(id,"^bloom"))
   target.LocalTransparencyModifier=if collected then 1 else 0
   for _,item in ipairs(target:GetDescendants()) do if item:IsA("BasePart") then item.LocalTransparencyModifier=if collected then 1 else 0 end end
   local pro=target:FindFirstChildOfClass("ProximityPrompt");if pro then pro.Enabled=false end
   local surface=target:FindFirstChildOfClass("SurfaceGui");local readout=surface and surface:FindFirstChild("Readout")
   local value=target:GetAttribute("Title")
   if string.match(id,"^digit[1234]$") then value=tostring(st.digits[tonumber(string.sub(id,-1))])
   elseif string.match(id,"^valve[1234]$") then value=if st.valves[tonumber(string.sub(id,-1))] then "ABERTA" else "FECHADA"
   elseif id=="pressure" then value=st.pressure.." BAR"
   elseif string.match(id,"^angle[123]$") then value=tostring(st.angles[tonumber(string.sub(id,-1))])
   elseif id=="exit" then value=if Campaign.complete(st) then "LIBERADO" else "BLOQUEADO" end
   if readout then readout.Text=value;surface.Enabled=not collected end
   if string.match(id,"^lamp[123456789]$") and target:FindFirstChild("Indicator") then target.Indicator.Color=if st.matrix[tonumber(string.sub(id,-1))] then Color3.fromRGB(240,190,50) else Color3.fromRGB(20,28,24) end
  end
 end
end
update.OnClientEvent:Connect(function(kind,payload)
 if kind=="Hand" then hands:launch(payload.point,payload.right);return end
 if kind=="HandHold" then hands:hold(payload.part,payload.right);return end
 if kind=="HandRelease" then hands:release(payload.right);return end
 if payload.state then data=payload;refreshWorld() end
 status.Text=payload.saveStatus or ""
 if payload.message then message=payload.message;messageUntil=os.clock()+4 end
 if kind=="Ready" then loaded=true;if mode=="menu" then mainMenu() end
 elseif kind=="Scene" or kind=="Ending" then task.spawn(scene,payload,kind=="Ending")
 elseif kind=="Dead" then mainMenu();heading.Text="ELE ENCONTROU VOCÊ";description.Text=payload.message or "Retome o checkpoint para tentar outra vez."
 elseif kind=="Won" then mainMenu();heading.Text="O SINAL NÃO MORREU";description.Text="FIM DO CAPÍTULO 1 / DEAD SIGNAL\nVocê saiu. A transmissão foi junto."
 elseif kind=="Paused" then mainMenu();mode="paused";heading.Text="PAUSADO";clearButtons();add("CONTINUAR",1,function() action:FireServer("Resume") end);add("CONFIGURAÇÕES",2,settings);add("MENU PRINCIPAL",3,mainMenu)
 elseif kind=="Document" then
  mode="reading";menu.Visible=true;hud.Visible=false;hands:setEnabled(false);mouse(true);heading.Text="PROTOCOLO";description.Text=payload.message or "";clearButtons();add("FECHAR",1,gameplay);playRadioTape()
 elseif data.active and not data.scene and not data.dead and mode~="reading" and mode~="cinema" then gameplay()
 elseif data.active and not data.scene and mode=="cinema" then gameplay() end
end)
RunService.RenderStepped:Connect(function()
 if mode=="playing" then
  local info=Config.Sectors[data.state.sector]
  objective.Text="DEAD SIGNAL / "..info.Name.."\n"..info.Goal.."\n"..Campaign.progress(data.state)
  local stamVal=math.clamp(data.stamina or 100,0,100)
  stamina.Text="FÔLEGO "..math.floor(stamVal).."%"
  staminaBar.Size=UDim2.fromOffset(math.floor(260*(stamVal/100)),18)
  staminaBar.BackgroundColor3=if stamVal<25 then Color3.fromRGB(220,60,50) else Color3.fromRGB(80,200,120)
  local target=targetAtCrosshair();prompt.Text=if os.clock()<messageUntil then message else if target then target:GetAttribute("Title").."  •  E / AZUL   Q / VERMELHA" else ""
 end
 local danger=Campaign.danger(data.state) and mode=="playing"
 if ambience then ambience.Volume=volume*(if voice and voice.IsPlaying then .1 else .32) end
 if pursuit then pursuit.Volume=if danger then volume*.55 else 0 end
end)
while not player:GetAttribute("BrambleBootDone") do task.wait(.1) end
gui.Enabled=true;mainMenu();action:FireServer("Sync")
