local fs=require('@lune/fs')
local R=require('@lune/roblox')
local dm=R.deserializePlace(fs.readFile('/tmp/still-here-verified.rbxl'))
local W=dm:GetService('Workspace')
local SS=dm:GetService('ServerStorage')
local RS=dm:GetService('ReplicatedStorage')
local SSS=dm:GetService('ServerScriptService')
local RF=dm:GetService('ReplicatedFirst')
local SP=dm:GetService('StarterPlayer')
assert(W:GetAttribute('DeadSignalBuildId')=='still-here-mystery-only-v1','Wrong mystery build')
assert(W:GetAttribute('MysteryWeaponsRemoved')==true,'Weapon cleanup was not recorded')
assert(W:GetAttribute('ExperienceChapter')==1 and W:GetAttribute('DisplayEpisodeLabel')=='MISTÉRIO','Mystery label missing')
local map=assert(SS:FindFirstChild('OriginalWorld'),'Original mansion map package missing')
local content=assert(map:FindFirstChild('Content'),'Mystery map Content missing')
assert(content.Interior and content.Exterior,'Mansion room hierarchy lost')
assert(content.Interior.Foyer and content.Interior.Livingroom and content.Interior.Kitchen,'Mansion rooms missing')
assert(not content.Exterior:FindFirstChild('EventTriggers'),'Event trigger folder remains')
assert((W:GetAttribute('MysteryStoryTriggerRemovalCount') or 0)>0,'No mystery trigger cleanup was recorded')
local storm=content.Exterior:FindFirstChild('Storm')
assert(not storm or not storm:FindFirstChild('CloudMesh'),'Cloud mesh remains')
assert(not content.Interior.Foyer:FindFirstChild('Ritual-DemoVersion'),'Foyer ritual remains')
local seats=0
for _,d in ipairs(content:GetDescendants()) do
 local name=string.lower(d.Name)
 assert(not name:find('ritual',1,true),'Ritual object remains in map: '..d:GetFullName())
 assert(not name:find('triggervolume',1,true),'Mystery trigger volume remains: '..d:GetFullName())
 if name:find('trigger',1,true) then
  local path=string.lower(d:GetFullName())
  assert(path:find('.door_interior_frame_',1,true) or path:find('.click_sit.',1,true),'Non-interaction mystery trigger remains: '..d:GetFullName())
 end
 assert(name~='suv_damaged' and not name:find('wreck',1,true),'Wreck remains: '..d:GetFullName())
 assert(not d:IsA('Tool') or name:find('key',1,true),'Weapon Tool remains in the map: '..d:GetFullName())
 assert(not name:find('weapon',1,true) and not name:find('firearm',1,true) and not name:find('rifle',1,true) and not name:find('pistol',1,true) and not name:find('shotgun',1,true) and name~='gun','Weapon prop remains in the map: '..d:GetFullName())
 if d:IsA('Seat') then seats+=1 end
end
assert(seats>0,'Mansion chair seats are missing')
for _,d in ipairs(dm:GetDescendants()) do
 if d:IsA('Tool') then assert(string.lower(d.Name):find('key',1,true),'Weapon Tool remains in packaged services: '..d:GetFullName()) end
end
for _,d in ipairs(W.Terrain:GetChildren()) do assert(not d:IsA('Clouds'),'Global cloud object remains') end
assert(SP.CameraMode==R.Enum.CameraMode.Classic and SP.CameraMinZoomDistance>=8 and SP.CameraMaxZoomDistance>SP.CameraMinZoomDistance,'First person is not disabled')
assert(not RS:FindFirstChild('MenuBackdrop') and not RS:FindFirstChild('ChapterTwoMap'),'Extra map or menu scene packaged')
assert(not RF:FindFirstChild('SessionMenuClient') and not RF:FindFirstChild('MenuAvatarClient') and not RF:FindFirstChild('ChapterTwoHUD'),'Menu/Chapter 2 client code packaged')
assert(not SSS:FindFirstChild('SessionRuntime') and not SSS:FindFirstChild('Weapons'),'Party runtime or weapon runtime packaged')
assert(not SSS.StillHereRuntime:FindFirstChild('ChapterTwoRuntime') and not SSS.StillHereRuntime:FindFirstChild('OriginalWeaponPickups'),'Chapter 2 or weapon spawn script packaged')
assert(not RF:FindFirstChild('OriginalWeaponHoldPrompt') and not RF:FindFirstChild('OriginalMissionHUD'),'Weapon pickup or mission HUD packaged')
assert(RS.OriginalStarterGui and RS.OriginalStarterGui:FindFirstChild('HUD'),'Mansion HUD missing')
local originalGui=RS.OriginalStarterGui
local credits=originalGui:FindFirstChild('Credits_01',true)
assert(not credits or not credits:IsA('GuiObject') or not credits.Visible,'Credits remain visible')
local ui=assert(RF:FindFirstChild('OriginalUIBootstrap'),'UI bootstrap missing')
assert(ui.Source:find("not name:find('menu'",1,true) and ui.Source:find("not name:find('credit'",1,true),'Menu or credits screen can still be cloned')
local init=assert(SSS.StillHereRuntime:FindFirstChild('OriginalInitializer'),'Original initializer missing')
assert(init.Source:find("W:SetAttribute('GameMode','Match')",1,true),'Game starts at a menu')
assert(not init.Source:find("W:SetAttribute('GameMode','Menu')",1,true),'Menu start state remains')
local interactions=assert(SSS.StillHereRuntime:FindFirstChild('WorldInteractions'),'World interaction script missing')
assert(interactions.Source:find('doorManager.EnableDoor(door)',1,true) and interactions.Source:find('MainDoorKeyRequired',1,true),'Main entrance is key-gated')
assert(interactions.Source:find("promptName:find('key',1,true)",1,true) and interactions.Source:find('d.Enabled=false',1,true),'Key-only door prompt remains available')
assert(interactions.Source:find("ActionText='Sentar'",1,true) and interactions.Source:find('seat:Sit(humanoid)',1,true),'Chair sitting is missing')
assert(not RS:FindFirstChild('SessionMenu') and RS:FindFirstChild('PlayerSettings'),'Custom party menu remains or settings remote is missing')
assert(SP.StarterPlayerScripts:FindFirstChild('SkyBlackHoleClient'),'Mystery sky effect missing')
local ui=assert(RF:FindFirstChild('OriginalUIBootstrap'),'Third-person client bootstrap missing')
assert(ui.Source:find('Enum.CameraMode.Classic',1,true) and ui.Source:find('CameraMinZoomDistance=8',1,true),'Client first person lock remains')
local loading=assert(RF:FindFirstChild('SessionLoadingClient'),'Loading screen missing')
assert(loading.Source:find('Carregando o casarão',1,true) and not loading.Source:find('EPISÓDIO',1,true),'Loading screen label is untranslated or still uses chapters')
local settings=assert(RS:FindFirstChild('SessionInterface'),'Settings interface missing')
assert(settings.Source:find('CONFIGURAÇÕES',1,true) and settings.Source:find('RESTAURAR PADRÃO',1,true),'Portuguese settings labels missing')
assert(not settings.Source:find('OPTIONS',1,true) and not settings.Source:find('EPISÓDIO 2',1,true),'English or Chapter 2 settings remain')
print('MYSTERY BUILD VERIFIED: one mansion map, no menu/Chapter 2/weapon/first person/story triggers/ritual/cloud/wreck; Portuguese loading, settings, sitting and permanent main-door access')
