local fs=require('@lune/fs')
local luau=require('@lune/luau')
local files={'session-interface.luau','session-menu-client.luau','menu-avatar-client.luau','blackhole-client.luau'}
for _,file in ipairs(files) do
 local source=fs.readFile(file)
 assert(source and #source>300,'Missing menu source: '..file)
 luau.load(source,{debugName=file})
end
local panel=fs.readFile('session-interface.luau')
assert(panel:find('local width=portrait and .94 or compact and .79 or .57',1,true),'Panel is not responsive on portrait/landscape')
assert(panel:find("GetPropertyChangedSignal('ViewportSize')",1,true),'Panel does not resize when mobile orientation changes')
assert(panel:find('local center=portrait and .50',1,true),'Portrait panel is not centered in viewport')
assert(panel:find("Name='OptionsHalf'",1,true),'Narrow options column missing')
assert(panel:find("Name='OptionCategoryStack'",1,true),'Category stack missing')
assert(panel:find("Tween:Create(tab.button,TweenInfo.new(.16)",1,true),'Category color transition missing')
assert(panel:find("Name='CategoryActiveMarker'",1,true),'Selected section red marker missing')
assert(panel:find('Tween:Create(right,TweenInfo.new(.24',1,true),'Right-side options transition missing')
assert(panel:find('local function leave(saveChanges)',1,true),'Settings save/discard actions are not separated')
assert(panel:find("cancel.Name='DiscardSettings'",1,true),'Discard button missing')
assert(panel:find("save.Name='SaveSettings'",1,true),'Save button missing')
assert(panel:find("Name='SettingsCategoryScroll'",1,true),'Category scroll missing')
assert(panel:find("Name='SettingsValuesScroll'",1,true),'Options scroll missing')
assert(panel:find('Name=\'Toggle_\'..spec[2]',1,true),'Boolean touch toggles not present')
assert(panel:find("Name='ValueProgress'",1,true),'Numeric setting value bar missing')
assert(panel:find('button.Activated:Connect(function() drawSettings(g) end)',1,true),'Category buttons do not switch settings')
assert(panel:find('changeValue(spec,direction);refresh()',1,true),'Numeric arrow settings not functional')
assert(panel:find('M.Dirty=true',1,true),'Settings edits not marked for saving')
assert(panel:find("panel.Status.Text='Erro ao carregar.",1,true),'Settings load errors not visible')
assert(panel:find("MenuCameraMode','close'",1,true),'Panel does not activate face camera')
assert(panel:find("MenuCameraMode','wide'",1,true),'Closing a panel does not restore wide camera')
for _,category in ipairs({'CALIBRAÇÃO','QUALIDADE','CONTROLES','JOGABILIDADE','ÁUDIO'}) do
 assert(panel:find(category,1,true),'Missing category '..category)
end

local figure=fs.readFile('menu-avatar-client.luau')
assert(figure:find('CreateHumanoidModelFromUserIdAsync',1,true),'Actual Roblox avatar not loaded')
assert(not figure:find('LoadAnimation(swim)',1,true),'Swim animation must not play in the menu')
assert(figure:find("model.Name='LowGravityAvatar'",1,true),'Real avatar cinematic missing')
assert(figure:find("LOW_GRAVITY_ANIMATION_ID='rbxassetid://91933762333526'",1,true),'Wrong AnimationId: catalog item ID is not the animation')
assert(figure:find('animation.AnimationId=LOW_GRAVITY_ANIMATION_ID',1,true),'Animator not loading the resolved Low Gravity sequence')
assert(figure:find('Players:GetHumanoidDescriptionFromUserIdAsync',1,true),'Avatar appearance source missing')
assert(figure:find('Players:CreateHumanoidModelFromDescriptionAsync(description,Enum.HumanoidRigType.R15)',1,true),'Low Gravity requires an R15 rig')
assert(not figure:find("animation.AnimationId='rbxassetid://103686359406944'",1,true),'Marketplace wrapper ID mistakenly used as AnimationId')
assert(figure:find('local function proceduralLevitation(t)',1,true),'Asset-independent backup animation missing')
assert(figure:find('motor.C0=rest*cf',1,true),'Fallback does not use persistent Motor6D.C0')
assert(not figure:find('motor.Transform=cf',1,true),'Fallback uses overwritten Motor6D.Transform')
assert(figure:find('proceduralLevitation(0)',1,true),'First frame is not posed while emote loads')
assert(figure:find('RunService:BindToRenderStep',1,true),'Fallback is not updated after camera')
assert(figure:find("status('procedural-stopped')",1,true),'Emote stopping does not recover automatically')
assert(figure:find('track.Length>.05 and track.IsPlaying',1,true),'Unverified emote playback can silently freeze')
assert(figure:find("local function status(value)",1,true),'Runtime emote state reporting missing')
assert(figure:find("status('asset')",1,true),'Emote playback is not tracked')
assert(not figure:find("water.Name='LocalDarkWaterSurface'",1,true),'Visible fake-water rectangle was not removed')
assert(not figure:find('Instance.new(\'Part\')',1,true),'Local surface parts are still obscuring the sky')
assert(figure:find('CameraZoom',1,true),'Cinematic camera zoom controller missing')
assert(figure:find('wideEye:Lerp(closeEye,t)',1,true),'No face close-up camera movement')
assert(not figure:find('PassingStone',1,true),'Artificial stone models still being generated')
assert(not figure:find("Instance.new('WedgePart')",1,true),'Artificial rock geometry still exists')
assert(figure:find('d.CanCollide=false;d.CanTouch=false;d.CanQuery=false',1,true),'Player copy must not interfere with collisions')

