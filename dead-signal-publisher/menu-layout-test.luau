assert(blackhole:find('base=targetObservation*observationToPivot',1,true),'Source view not mapped to menu camera')
assert(blackhole:find('sourceAnimationId',1,true),'Original rock animation ID not read from source template')
assert(blackhole:find("sourceAnimationId=='7239753826'",1,true),'Original animation ID was replaced')
assert(blackhole:find('animator:LoadAnimation(animation)',1,true),'Original rock animation track not loaded')
assert(blackhole:find('debrisTrack:Play(0,1,1)',1,true),'Original animation playback speed not preserved')
assert(blackhole:find('boneCount>=162',1,true),'Original rock bone count not checked')
assert(not blackhole:find('field:ScaleTo',1,true),'Original debris has its own scale overridden')
