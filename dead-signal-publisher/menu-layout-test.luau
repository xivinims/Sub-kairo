local fs=require('@lune/fs')
local luau=require('@lune/luau')
local files={'session-interface.luau','session-menu-client.luau','menu-avatar-client.luau','blackhole-client.luau'}
for _,file in ipairs(files) do
 local source=fs.readFile(file)
 assert(source and #source>300,'Missing menu source: '..file)
 luau.load(source,{debugName=file})
end
local panel=fs.readFile('session-interface.luau')
assert(panel:find('local width=compact and .76 or .55',1,true),'Settings panel covers the screen')
assert(panel:find("Name='OptionsHalf'",1,true),'Narrow options column missing')
assert(panel:find("Name='OptionCategoryStack'",1,true),'Category stack missing')
assert(panel:find('Tween:Create(categories,transition',1,true),'Category transition missing')
assert(panel:find('Tween:Create(right,transition',1,true),'Options transition missing')
assert(panel:find("MenuCameraMode','close'",1,true),'Panel does not activate face camera')
assert(panel:find("MenuCameraMode','wide'",1,true),'Closing a panel does not restore wide camera')
for _,category in ipairs({'CALIBRAÇÃO','QUALIDADE','CONTROLES','JOGABILIDADE','ÁUDIO'}) do
 assert(panel:find(category,1,true),'Missing category '..category)
end

local figure=fs.readFile('menu-avatar-client.luau')
assert(figure:find('CreateHumanoidModelFromUserIdAsync',1,true),'Actual Roblox avatar not loaded')
assert(not figure:find('LoadAnimation(swim)',1,true),'Swim animation must not play in the menu')
assert(figure:find("model.Name='LowGravityAvatar'",1,true),'Real avatar cinematic missing')
assert(figure:find("animation.AnimationId='rbxassetid://103686359406944'",1,true),'Requested Low Gravity emote missing')
assert(figure:find('originalFloatPose(t)',1,true),'Independent no-asset fallback missing')
assert(figure:find("MenuEmoteMode','procedural'",1,true),'Procedural fallback is not enabled by default')
assert(figure:find("MenuEmoteMode','asset'",1,true),'Emote playback is not tracked')
assert(figure:find('track.Length>0',1,true),'Missing emote-failure detection')
assert(not figure:find("water.Name='LocalDarkWaterSurface'",1,true),'Visible fake-water rectangle was not removed')
assert(not figure:find('Instance.new(\'Part\')',1,true),'Local surface parts are still obscuring the sky')
assert(figure:find('CameraZoom',1,true),'Cinematic camera zoom controller missing')
assert(figure:find('wideEye:Lerp(closeEye,t)',1,true),'No face close-up camera movement')
assert(not figure:find('PassingStone',1,true),'Artificial stone models still being generated')
assert(not figure:find("Instance.new('WedgePart')",1,true),'Artificial rock geometry still exists')
assert(figure:find('d.CanCollide=false;d.CanTouch=false;d.CanQuery=false',1,true),'Player copy must not interfere with collisions')

local blackhole=fs.readFile('blackhole-client.luau')
assert(blackhole:find("=='Menu'",1,true),'Original black hole disabled in menu')
assert(blackhole:find("local halo=assert(model:FindFirstChild('Halo',true)",1,true),'Original singularity target missing')
assert(blackhole:find('local sourceObservation=CFrame.lookAt',1,true),'Original source perspective not recorded')
assert(blackhole:find('base=targetObservation*observationToPivot',1,true),'Source view not mapped to menu camera')
assert(blackhole:find('sourceAnimationId',1,true),'Original rock animation ID not read from source template')
assert(blackhole:find("sourceAnimationId=='7239753826'",1,true),'Original animation ID was replaced')
assert(blackhole:find('animator:LoadAnimation(animation)',1,true),'Original rock animation track not loaded')
assert(blackhole:find('debrisTrack:Play(0,1,1)',1,true),'Original animation playback speed not preserved')
assert(blackhole:find('boneCount>=162',1,true),'Original rock bone count not checked')
assert(not blackhole:find('field:ScaleTo',1,true),'Original debris has its own scale overridden')
assert(not blackhole:find('shardBones',1,true),'Only a subset of the original bones are animated')
assert(not blackhole:find('field:PivotTo',1,true),'Original debris formation is moved separately')
assert(blackhole:find("enabled=d.Enabled",1,true),'Original singularity GUI was disabled')
assert(blackhole:find("local distance=menu and 565 or 900",1,true),'Original disc distance wrong')
assert(blackhole:find('math.clamp(190/haloDiameter,.78,.90)',1,true),'Halo size not measured')
assert(blackhole:find("localBurst()",1,true),'Local explosion controller missing')
assert(blackhole:find("voidBackdrop.Name='LocalBlackVoidBackdrop'",1,true),'Bright orange sky still visible')
assert(blackhole:find('Color3.fromRGB(0,0,2)',1,true),'Menu void is not near-black')
assert(not blackhole:find("sourceSky:Clone().Parent=lighting",1,true),'Old orange skybox still installed')

local menu=fs.readFile('session-menu-client.luau')
assert(menu:find("MenuCameraMode','wide'",1,true),'Opening camera state missing')
assert(menu:find("MenuCameraMode','starting'",1,true),'Launching camera state missing')
assert(menu:find("local startLabel=UI.Label(bg,'INICIANDO...'",1,true),'Solo transition label missing')
assert(menu:find('composition.Visible=false',1,true),'Main menu is not hidden when starting')
assert(menu:find('restorePresentation()',1,true),'Launch error recovery missing')
assert(menu:find('lighting.ExposureCompensation=-.32',1,true),'Original sky overexposed')
assert(not menu:find("local shade=make('Frame'",1,true),'Menu contains old dark rectangle')
local doors=fs.readFile('original-door-fixes.luau')
assert(not doors:find('InstallPlayerLock',1,true),'Custom door locks are still installed')
print('LOW GRAVITY MENU PASS: independent coded avatar float and source emote 103686359406944, no fake water, original 160-rock rig')
