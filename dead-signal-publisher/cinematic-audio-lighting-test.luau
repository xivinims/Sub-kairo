local fs=require('@lune/fs')
local luau=require('@lune/luau')
local R=require('@lune/roblox')
local code=fs.readFile('cinematic-environment-client.luau')
luau.load(code,{debugName='cinematic-environment-client'})
assert(code:find("music.SoundId='rbxassetid://9045936046'",1,true),'Incorrect menu audio asset')
assert(code:find("music.Looped=true",1,true),'Menu ambience must loop')
assert(code:find('music.PlaybackSpeed=1',1,true),'Exact original audio playback speed changed')
assert(code:find("if not menu then return end",1,true),'Menu audio can play in a match')
assert(code:find("MenuCameraMode')=='starting'",1,true),'Menu audio does not fade at start')
assert(code:find("music:Stop();music:Destroy()",1,true),'Audio does not stop on game mode transition')
assert(code:find("ContentProvider:PreloadAsync({music})",1,true),'Menu audio preload unavailable')
assert(code:find("local bloom=addEffect('BloomEffect'",1,true),'Cinematic bloom missing')
assert(code:find("local grade=addEffect('ColorCorrectionEffect'",1,true),'High-contrast grading missing')
assert(code:find("local dof=addEffect('DepthOfFieldEffect'",1,true),'Depth of field missing')
assert(code:find("addEffect('Atmosphere'",1,true),'Dense atmospheric effects missing')
assert(code:find("addEffect('SunRaysEffect'",1,true),'Volumetric sun rays missing')
assert(code:find('lamp.Shadows=true',1,true),'Menu shadow-casting lights missing')
assert(code:find('light.Shadows=true',1,true),'Mansion source lights do not cast local shadows')
assert(not code:find('FrameRate',1,true),'Cinematic must not artificially throttle the game')
local place=R.deserializePlace(fs.readFile('/tmp/still-here-original.rbxl'))
local rf=place:GetService('ReplicatedFirst')
local ls=rf:FindFirstChild('CinematicEnvironmentClient')
assert(ls and ls:IsA('LocalScript'),'Cinematic environment not installed')
assert(ls.Source==code,'Menu audio+lighting source mismatch')
local menu=rf:FindFirstChild('SessionMenuClient')
assert(menu and menu:IsA('LocalScript'),'Original menu removed')
local lighting=place:GetService('Lighting')
assert(lighting,'Global lighting unavailable')
print('CINEMATIC SOUND/LIGHTING TEST PASS: original Roblox 9045936046 loop, fade, postprocess and shadow-casting local lights packaged')
