local fs=require('@lune/fs')
local luau=require('@lune/luau')
local R=require('@lune/roblox')
local code=fs.readFile('cinematic-environment-client.luau')
luau.load(code,{debugName='cinematic-environment-client'})
assert(not code:find('MenuCameraMode',1,true) and not code:find('9045936046',1,true),'Menu camera or music remains')
assert(code:find("addEffect('BloomEffect'",1,true),'Cinematic bloom missing')
assert(code:find("addEffect('ColorCorrectionEffect'",1,true),'High-contrast grading missing')
assert(code:find("addEffect('DepthOfFieldEffect'",1,true),'Depth of field missing')
assert(code:find("addEffect('Atmosphere'",1,true),'Atmospheric effects missing')
assert(code:find("addEffect('SunRaysEffect'",1,true),'Sun rays missing')
assert(code:find('light.Shadows=true',1,true),'Mansion fixtures do not cast soft shadows')
assert(not code:find('FrameRate',1,true),'Cinematic setup must not artificially throttle the game')
local place=R.deserializePlace(fs.readFile('/tmp/still-here-original.rbxl'))
local rf=place:GetService('ReplicatedFirst')
local script=rf:FindFirstChild('CinematicEnvironmentClient')
assert(script and script:IsA('LocalScript'),'Cinematic environment not installed')
assert(script.Source==code,'Cinematic lighting source mismatch')
assert(not rf:FindFirstChild('SessionMenuClient'),'Main menu script remains')
assert(place:GetService('Lighting'),'Global lighting unavailable')
print('MANSION LIGHTING PASS: post-processing, atmospheric depth, sun rays, real fixture shadows; no menu or menu audio')
