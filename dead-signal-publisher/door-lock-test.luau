-- Regression: prevent custom locks from creeping back into original mansion doors.
local fs=require('@lune/fs')
local luau=require('@lune/luau')
local R=require('@lune/roblox')
local source=fs.readFile('original-door-fixes.luau')
luau.load(source,{debugName='original-door-fixes'})
assert(source:find('original-only-v2',1,true),'Original-only door marker missing')
assert(not source:find('InstallPlayerLock',1,true),'Custom player locks still injected')
assert(not source:find("fs.readFile('door-lock-extension.luau')",1,true),'Double-click lock script imported')
local dm=R.deserializePlace(fs.readFile('/tmp/still-here-original.rbxl'))
local door=dm:GetService('ServerScriptService'):FindFirstChild('DoorManager')
assert(door and door:IsA('ModuleScript'),'Original DoorManager removed')
assert(not door.Source:find('InstallPlayerLock',1,true),'Custom door locks installed in release')
assert(not door.Source:find('PlayerDoorLock',1,true),'Custom door lock prompts installed in release')
assert(door.Source:find('function DoorManager.EnableDoor',1,true),'Campaign-enabled doors missing')
print('ORIGINAL DOORS PASS: default automatic doors retained; custom double-tap player locks removed')
