assert(game.GameId==9419478735 and game.PlaceId==79738710219521,"Place errado")
local CS=game:GetService("CollectionService")
local rt=game.ReplicatedStorage:FindFirstChild("SweanRuntime")
assert(rt and rt:GetAttribute("Version")==102,"runtime v102 missing")
assert(rt:GetAttribute("ExperienceName")=="XN [VOICE]","identity wrong")
assert(rt:GetAttribute("MapAssetId")==106476929993683,"map id wrong")
local map=workspace:FindFirstChild("XN_City"); assert(map and map:IsA("Model"),"XN_City missing")
assert(map:GetAttribute("AssetId")==106476929993683,"map source wrong")
local scripts=0; local parts=0
for _,d in ipairs(map:GetDescendants()) do if d:IsA("LuaSourceContainer") then scripts+=1 elseif d:IsA("BasePart") then parts+=1 end end
assert(scripts==0,"embedded scripts remain "..scripts)
assert(parts>9000,"too few city parts "..parts)
assert(not map:FindFirstChild("Vehicles",true),"Vehicles collection remains")
local green=CS:GetTagged("XNGreenGround"); assert(#green>20,"green surfaces missing")
local grass=workspace:FindFirstChild("XN_Grass"); assert(grass and #grass:GetChildren()>50,"grass missing")
local deco=workspace:FindFirstChild("XN_Halloween"); assert(deco and deco:GetAttribute("OnlyPumpkins")==true,"Halloween wrong")
local pc=0; for _,d in ipairs(deco:GetDescendants()) do if d:IsA("BasePart") then assert(d.Name=="Pumpkin","non-pumpkin Halloween object"); pc+=1 end end
assert(pc>=20,"too few pumpkins "..pc)
local wind=game.StarterPlayer.StarterPlayerScripts:FindFirstChild("WindController"); assert(wind and wind:GetAttribute("AssetId")==11946229834,"wind missing")
assert(workspace.GlobalWind.Magnitude>10,"global wind weak")
local loader=game.ReplicatedFirst:FindFirstChild("XNLoading"); assert(loader and loader:IsA("LocalScript"),"loading missing")
assert(loader.Source:find('txt.Text="acessando…"',1,true),"loading text wrong")
assert(loader.Source:find("CameraMode.Classic",1,true),"camera rotation not free")
assert(workspace:FindFirstChild("XNSpawn"),"spawn missing")
return {ok=true,version=102,mapParts=parts,scriptsRemoved=rt:GetAttribute("OriginalScriptsRemoved"),vehiclesRemoved=rt:GetAttribute("VehiclesRemoved"),greenSurfaces=#green,grass=#grass:GetChildren(),windTagged=rt:GetAttribute("WindTagged"),pumpkins=pc,name="XN [VOICE]"}
