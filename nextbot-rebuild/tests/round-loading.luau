local fs=require('@lune/fs');local luau=require('@lune/luau')
local State=luau.load(fs.readFile('nextbot-rebuild/RoundState.luau'))()
local Loading=luau.load(fs.readFile('nextbot-rebuild/LoadingPolicy.luau'))()
local s=State.new(100,30,180)
assert(not State.tick(s,129,true))
assert(not State.tick(s,130,false)and s.deadline==131)
assert(State.tick(s,131,true)and s.round==1 and s.deadline==311)
assert(State.tick(s,311,false)and s.phase=='Intermission'and s.deadline==341)
s.phase='Voting';s.deadline=0;assert(not State.tick(s,1000,true),'Voting cannot start bots')
s.phase='Loading';assert(not State.tick(s,1000,true),'Loading cannot start bots')
local cycle=State.new(0,30,180)
for i=1,3 do assert(State.NextKind(cycle,true,function()return 2 end)=='normal')end
assert(State.NextKind(cycle,true,function()return 2 end)=='chasers')
assert(State.NextKind(cycle,true,function()return 2 end)=='chasers')
assert(State.NextKind(cycle,true,function()return 2 end)=='normal')
local single=State.new(0,30,180)
for i=1,3 do State.NextKind(single,true)end
assert(State.NextKind(single,true,function()return 1 end)=='chasers')
assert(State.NextKind(single,true)=='normal')
assert(State.NextKind(single,false)=='normal','Unavailable rig cannot create a fake special')
local choices={'A','B','C'}
local counts=State.CountVotes({p1='A',p2='B',p3='B',p4='injected'},choices)
assert(counts.A==1 and counts.B==2 and counts.C==0 and counts.injected==nil)
assert(State.Winner({p1='A',p2='B',p3='B'},choices,'C')=='B')
assert(State.Winner({},choices,'C')=='C')
assert(State.Winner({p1='A',p2='B'},choices,'C',function()return 2 end)=='B')
assert(not Loading.CanReveal(false,true,5,5,true))
assert(not Loading.CanReveal(true,true,5,4,true))
assert(not Loading.CanReveal(true,true,5,5,false))
assert(Loading.CanReveal(true,true,5,5,true))
assert(not Loading.MapReplicated(nil,100))
assert(not Loading.MapReplicated(100,99))
assert(Loading.MapReplicated(100,100))
print('Round/vote/special-cycle/loading readiness tests passed')
